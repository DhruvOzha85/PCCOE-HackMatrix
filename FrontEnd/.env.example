# ==============================================================================
# FIN FrontEnd - Environment Variables Template
# ==============================================================================

# Required: Origin/Base URL of the deployed BackEnd Express API (do NOT append /api or trailing slash)
# Production e.g.: https://fin-backend-99yh.onrender.com
# Local development default: http://localhost:5000
VITE_API_URL=http://localhost:5000

# Optional: Session inactivity timeout in seconds (default: 1800 = 30 minutes)
VITE_SESSION_TIMEOUT_SEC=1800

# Optional: Session warning countdown before logout (default: 300 = 5 minutes)
VITE_SESSION_WARNING_SEC=300

# Optional: Development-only authentication bypass toggle (default: false)
# Strictly ignored when NODE_ENV=production
VITE_ENABLE_DEV_AUTH_BYPASS=false
