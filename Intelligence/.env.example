# ==============================================================================
# FIN Intelligence Microservice - Environment Variables Template
# ==============================================================================

# Microservice Host & Port
AI_ENV=production
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=INFO
AI_DEBUG=false

# Service-to-Service Internal Authentication (Min 16 chars)
# Must match AI_SERVICE_API_KEY in BackEnd/.env
AI_SERVICE_API_KEY=change-me-to-a-secure-random-32-char-key

# BackEnd API URL (for reverse callbacks or webhooks)
BACKEND_SERVICE_URL=http://localhost:5000

# LLM Provider Configuration: 'gemini', 'openrouter', or 'auto'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Optional: OpenRouter Fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding & RAG Configuration
# Set USE_MOCK_EMBEDDINGS=true for free-tier / 512MB RAM instances (Render free tier)
# Set USE_MOCK_EMBEDDINGS=false for full semantic retrieval using BAAI/bge-m3 (requires >=2GB RAM)
USE_MOCK_EMBEDDINGS=false
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3

# Vector Store Settings
VECTORSTORE_BACKEND=faiss
VECTORSTORE_PERSIST_DIR=data/indexes
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=10

# Optional Supabase Integration (if sync is enabled)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_ROLE_KEY=
